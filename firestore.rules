rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (getUserRole() == 'admin' || getUserRole() == 'master_admin');
    }

    function isMasterAdmin() {
      return isAuthenticated() && getUserRole() == 'master_admin';
    }

    // Employees collection - user profiles
    // Master Admin / Admin can read/update/delete any employee document
    match /employees/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isMasterAdmin();
    }

    // User profiles collection - extended user information
    match /userProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isMasterAdmin();
    }

    // App configuration (version control)
    match /app_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pages / forms configuration
    match /pages/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Page configurations
    match /page_configurations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Form configurations (dynamic form fields)
    // Used by data entry and reports pages to load field definitions
    match /formConfigs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Legacy forms collection (used as fallback by FormConfigService)
    match /forms/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Categories / form folders
    match /categories/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User favorites
    match /user_favorites/{document} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // File uploads metadata
    match /file_uploads/{document} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Dynamic form submissions (Firestore copy)
    match /dynamic_form_submissions/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Form submissions (Firestore collection used by Reports and DynamicReportsTable)
    match /form_submissions/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Offices
    match /offices/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{document} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
